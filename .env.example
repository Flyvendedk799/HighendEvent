# ---------------------------------------------------------------- Core
DATABASE_URL=postgresql://rentora:rentora@localhost:5432/rentora
REDIS_URL=redis://localhost:6379

# Distinguishes apex marketing from {tenant}.PLATFORM_DOMAIN storefronts.
PLATFORM_DOMAIN=localhost:3000

# Where the browser-facing server calls the API.
NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------- Auth
# MUST be set in production. The API falls back to a well-known dev value otherwise.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------- Payments
# Leave unset to run checkout in clearly-labelled no-charge mode.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Without this the API accepts unverified webhooks. Always set it in production.
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_PRICE_STARTER=
STRIPE_PLATFORM_PRICE_GROWTH=
STRIPE_PLATFORM_PRICE_SCALE=

# ---------------------------------------------------------------- Email
# Unset: emails are rendered and logged, and reported as not delivered.
RESEND_API_KEY=
EMAIL_FROM=Rentora <bookings@alarent.app>

# ---------------------------------------------------------------- Media
# S3-compatible object storage. Unset: uploads are disabled and the admin says so.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rentora
R2_PUBLIC_URL=

# ---------------------------------------------------------------- Delivery
# Unset: delivery distance falls back to a deterministic estimate, labelled as such.
MAPBOX_ACCESS_TOKEN=

# ---------------------------------------------------------------- Custom domains
# The value tenants point their CNAME/ALIAS record at.
CUSTOM_DOMAIN_TARGET=cname.alarent.app
DOMAIN_CHALLENGE_SECRET=change-me

# ---------------------------------------------------------------- Seed
SEED_PLATFORM_PASSWORD=admin123
SEED_STAFF_PASSWORD=demo1234
SEED_CUSTOMER_PASSWORD=customer123
