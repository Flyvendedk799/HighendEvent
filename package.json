{
  "name": "rentora",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @rentora/db generate",
    "db:migrate": "pnpm --filter @rentora/db migrate:dev",
    "db:seed": "pnpm --filter @rentora/db seed",
    "check:isolation": "tsx scripts/check-tenant-isolation.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:deploy": "pnpm --filter @rentora/db migrate:deploy",
    "db:check-migrations": "tsx scripts/check-migrations.ts",
    "test:e2e": "pnpm --filter @rentora/web test:e2e"
  },
  "devDependencies": {
    "@rentora/db": "workspace:*",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
